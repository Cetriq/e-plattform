# Database
DB_PASSWORD=devpassword

# Meilisearch
MEILI_KEY=devmasterkey123

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Grafana
GRAFANA_PASSWORD=admin

# Demo login
# Shared code visitors must enter before choosing a persona (empty = no code)
DEMO_ACCESS_CODE=
# Give each citizen visitor a new, isolated account (true for a public demo)
DEMO_ISOLATED_CITIZENS=false

# Token signing key, at least 32 characters. Optional locally (the dev profile
# has a default); required for every deployed environment.
# JWT_SECRET=

# Production only
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com
# REGISTRY=your-registry.io
# VERSION=latest
